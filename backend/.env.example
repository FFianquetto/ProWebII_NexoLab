PORT=4000
NODE_ENV=development

# --- MongoDB Database URL ---
# Servicio Online (MongoDB Atlas recomendado):
# DATABASE_URL="mongodb+srv://<usuario>:<password>@cluster0.xxxxx.mongodb.net/nexolab?retryWrites=true&w=majority"
#
# Servicio Local / Contenedor:
# DATABASE_URL="mongodb://127.0.0.1:27017/nexolab?authSource=admin"
DATABASE_URL="mongodb+srv://<usuario>:<password>@cluster0.xxxxx.mongodb.net/nexolab?retryWrites=true&w=majority&serverSelectionTimeoutMS=8000"

# --- Seguridad & JWT ---
JWT_SECRET="nexolab-dev-secret-change-in-production"
JWT_EXPIRES_IN="8h"
LOG_DIR=./logs

# --- Application ---
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:2000
APP_TIMEZONE=America/Monterrey
