generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum LabStatus {
  AVAILABLE
  MAINTENANCE
  CLOSED
}

enum EquipmentStatus {
  AVAILABLE
  IN_USE
  BROKEN
  MAINTENANCE
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentKind {
  LABORATORY
  EQUIPMENT
}

model User {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  email        String        @unique
  passwordHash String        @map("password_hash")
  fullName     String        @map("full_name")
  role         Role          @default(STUDENT)
  studentId    String?       @map("student_id")
  phone        String?
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  reservations Reservation[]
  incidents    Incident[]    @relation("ReportedBy")
  reports      Report[]      @relation("ReportAuthor")

  @@map("users")
}

model Subject {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  code         String        @unique
  name         String
  description  String?
  credits      Int           @default(0)
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  reservations Reservation[]

  @@map("subjects")
}

model Laboratory {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  code         String        @unique
  name         String
  building     String
  floor        String?
  capacity     Int
  status       LabStatus     @default(AVAILABLE)
  description  String?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  equipment    Equipment[]
  reservations Reservation[]
  incidents    Incident[]
  reports      Report[]

  @@map("laboratories")
}

model Equipment {
  id                   String                 @id @default(auto()) @map("_id") @db.ObjectId
  inventoryCode        String                 @unique @map("inventory_code")
  name                 String
  category             String
  status               EquipmentStatus        @default(AVAILABLE)
  laboratoryId         String                 @map("laboratory_id") @db.ObjectId
  notes                String?
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  laboratory           Laboratory             @relation(fields: [laboratoryId], references: [id])
  reservationEquipment ReservationEquipment[]
  incidents            Incident[]

  @@index([laboratoryId])
  @@map("equipment")
}

model Reservation {
  id                   String                 @id @default(auto()) @map("_id") @db.ObjectId
  userId               String                 @map("user_id") @db.ObjectId
  laboratoryId         String                 @map("laboratory_id") @db.ObjectId
  subjectId            String?                @map("subject_id") @db.ObjectId
  title                String
  purpose              String?
  startsAt             DateTime               @map("starts_at")
  endsAt               DateTime               @map("ends_at")
  attendees            Int                    @default(1)
  status               ReservationStatus      @default(PENDING)
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  user                 User                   @relation(fields: [userId], references: [id])
  laboratory           Laboratory             @relation(fields: [laboratoryId], references: [id])
  subject              Subject?               @relation(fields: [subjectId], references: [id])
  reservationEquipment ReservationEquipment[]

  @@index([userId])
  @@index([laboratoryId])
  @@index([subjectId])
  @@map("reservations")
}

model ReservationEquipment {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  reservationId String      @map("reservation_id") @db.ObjectId
  equipmentId   String      @map("equipment_id") @db.ObjectId
  quantity      Int         @default(1)
  createdAt     DateTime    @default(now()) @map("created_at")
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  equipment     Equipment   @relation(fields: [equipmentId], references: [id])

  @@unique([reservationId, equipmentId])
  @@index([equipmentId])
  @@map("reservation_equipment")
}

model Incident {
  id           String           @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String
  kind         IncidentKind     @default(LABORATORY)
  status       IncidentStatus   @default(OPEN)
  severity     IncidentSeverity @default(MEDIUM)
  laboratoryId String?          @map("laboratory_id") @db.ObjectId
  equipmentId  String?          @map("equipment_id") @db.ObjectId
  reportedById String           @map("reported_by_id") @db.ObjectId
  resolvedAt   DateTime?        @map("resolved_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  laboratory   Laboratory?      @relation(fields: [laboratoryId], references: [id])
  equipment    Equipment?       @relation(fields: [equipmentId], references: [id])
  reportedBy   User             @relation("ReportedBy", fields: [reportedById], references: [id])

  @@index([laboratoryId])
  @@index([equipmentId])
  @@index([reportedById])
  @@index([kind])
  @@map("incidents")
}

model Report {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  type         String      @default("GENERAL") // GENERAL | INCIDENTS | OCCUPANCY | EQUIPMENT
  summary      String
  notes        String?
  laboratoryId String?     @map("laboratory_id") @db.ObjectId
  createdById  String      @map("created_by_id") @db.ObjectId
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  laboratory   Laboratory? @relation(fields: [laboratoryId], references: [id])
  createdBy    User        @relation("ReportAuthor", fields: [createdById], references: [id])

  @@index([laboratoryId])
  @@index([createdById])
  @@map("reports")
}
